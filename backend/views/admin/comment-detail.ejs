<div class="admin-shell"><aside class="admin-sidebar"><div class="admin-brand"><a href="/admin" class="admin-brand-link"><img src="/Vakibh/vaakibh_logo.svg" alt="वाकीभ"><div><strong>वाकीभ</strong><span>Admin Console</span></div></a></div><nav class="admin-nav"><a href="/admin">Dashboard</a><a href="/admin/posts">Blogs</a><a href="/admin/comments" class="active">Feedback</a><a href="/admin/categories">Categories</a><a href="/admin/audio">ऑडिओ व्यवस्थापन</a><a href="/admin/posts/new">Add Blog</a><a href="/admin/posts/import-blogger">Import from Blogger</a><a href="/blog/index.html" target="_blank">Public Blog</a></nav><div class="admin-sidebar-card"><span class="admin-sidebar-label">Logged in as</span><strong><%= currentUser?.name||'Admin' %></strong><small><%= currentUser?.email||'' %></small></div></aside><main class="admin-main">
<header class="admin-topbar"><div><p class="admin-breadcrumb"><a href="/admin/comments">Feedback</a><span>/</span><span>#<%= comment.id %></span></p><h1>Feedback & Replies</h1></div></header><% if(notice){ %><div class="admin-alert admin-alert-success"><%= notice %></div><% } %><% if(error){ %><div class="admin-alert admin-alert-error"><%= error %></div><% } %>
<article class="admin-feedback-card"><header class="admin-feedback-head"><div><span class="admin-feedback-id">#<%= comment.id %></span><h2><%= comment.author_name %></h2></div><span class="admin-status admin-status-<%= comment.status %>"><%= comment.status %></span></header><dl class="admin-feedback-meta"><div><dt>Mobile</dt><dd><%= comment.author_mobile||comment.author_contact||'-' %></dd></div><div><dt>Email</dt><dd><%= comment.author_email||'-' %></dd></div><div><dt>Blog</dt><dd><%= comment.post_title||comment.post_slug %></dd></div></dl><div class="admin-feedback-message"><span>Full Feedback</span><p><%= comment.comment_text %></p></div></article>
<section class="admin-panel"><header class="admin-panel-header"><div><h3>Replies (<%= comment.replies.length %>)</h3><p>Replies थेट public होतात. नको असलेला reply delete करा.</p></div></header><div class="admin-feedback-list"><% if(!comment.replies.length){ %><div class="admin-empty-inline">या feedback ला replies नाहीत.</div><% } %><% comment.replies.forEach(reply=>{ %><article class="admin-feedback-card"><header class="admin-feedback-head"><div><span class="admin-feedback-id">Reply #<%= reply.id %></span><h3><%= reply.author_name %></h3></div><span class="admin-status admin-status-approved">Published</span></header><dl class="admin-feedback-meta"><div><dt>Mobile</dt><dd><%= reply.author_mobile %></dd></div><div><dt>Email</dt><dd><%= reply.author_email %></dd></div><div><dt>Date & Time</dt><dd><%= formatDate(reply.created_at) %></dd></div></dl><div class="admin-feedback-message"><span>Reply</span><p><%= reply.reply_text %></p></div><div class="admin-row-actions"><form method="post" action="/admin/replies/<%= reply.id %>/delete" onsubmit="return confirm('हा reply delete करायचा आहे का?');"><input type="hidden" name="feedback_id" value="<%= comment.id %>"><button class="admin-action-link danger">Delete</button></form></div></article><% }) %></div></section></main></div>
