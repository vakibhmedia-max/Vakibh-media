<% const stats=commentStats||{}; const tabs=['pending','approved','rejected']; %>
<div class="admin-shell"><aside class="admin-sidebar"><div class="admin-brand"><a href="/admin" class="admin-brand-link"><img src="/Vakibh/vaakibh_logo.svg" alt="वाकीभ लोगो"><div><strong>वाकीभ</strong><span>Admin Console</span></div></a></div><nav class="admin-nav"><a href="/admin"><i class="fas fa-chart-line"></i>Dashboard</a><a href="/admin/posts"><i class="fas fa-newspaper"></i>Blogs</a><a href="/admin/comments" class="active"><i class="fas fa-comments"></i>Feedback</a><a href="/admin/categories"><i class="fas fa-tags"></i>Categories</a><a href="/admin/audio"><i class="fas fa-music"></i>ऑडिओ व्यवस्थापन</a><a href="/admin/posts/new"><i class="fas fa-plus-circle"></i>Add Blog</a><a href="/admin/posts/import-blogger"><i class="fas fa-file-import"></i>Import from Blogger</a><a href="/blog/index.html" target="_blank"><i class="fas fa-external-link-alt"></i>Public Blog</a></nav><div class="admin-sidebar-card"><span class="admin-sidebar-label">Logged in as</span><strong><%= currentUser?.name||'Admin' %></strong><small><%= currentUser?.email||'' %></small></div></aside>
<main class="admin-main"><header class="admin-topbar"><div><p class="admin-breadcrumb"><a href="/admin">Dashboard</a><span>/</span><span>Feedback</span></p><h1>Blog Feedback</h1></div><form method="post" action="/admin/logout"><button class="admin-button admin-button-ghost">Logout</button></form></header><% if(notice){ %><div class="admin-alert admin-alert-success"><%= notice %></div><% } %><% if(error){ %><div class="admin-alert admin-alert-error"><%= error %></div><% } %>
<section class="admin-stats-grid admin-stats-grid-six"><% [['Total',stats.total_comments],['Pending',stats.pending_comments],['Approved',stats.approved_comments],['Rejected',stats.rejected_comments],['Total Replies',stats.total_replies],['Pending Replies',stats.pending_replies]].forEach(item=>{ %><article class="admin-stat-card"><span><%= item[0] %></span><strong><%= item[1]||0 %></strong></article><% }) %></section>
<section class="admin-panel"><header class="admin-panel-header"><div><h3>All Replies (<%= pendingReplies?.length||0 %>)</h3><p>Replies submit झाल्यानंतर थेट public दिसतात. नको असलेला reply येथे delete करा.</p></div></header><div class="admin-feedback-list"><% if(!pendingReplies||!pendingReplies.length){ %><div class="admin-empty-inline">Replies नाहीत.</div><% } else { pendingReplies.forEach(reply=>{ %><article class="admin-feedback-card"><header class="admin-feedback-head"><div><span class="admin-feedback-id">Reply #<%= reply.id %> · Feedback #<%= reply.feedback_id %></span><h3><%= reply.author_name %></h3></div><span class="admin-status admin-status-approved">Published</span></header><dl class="admin-feedback-meta"><div><dt>Blog</dt><dd><%= reply.post_title||reply.post_slug %></dd></div><div><dt>Feedback by</dt><dd><%= reply.feedback_author %></dd></div><div><dt>Mobile</dt><dd><%= reply.author_mobile %></dd></div><div><dt>Email</dt><dd><%= reply.author_email %></dd></div></dl><div class="admin-feedback-message"><span>Reply</span><p><%= reply.reply_text %></p></div><div class="admin-row-actions admin-feedback-actions"><a class="admin-action-link" href="/admin/comments/<%= reply.feedback_id %>">Open Feedback</a><form method="post" action="/admin/replies/<%= reply.id %>/delete" onsubmit="return confirm('हा reply delete करायचा आहे का?');"><input type="hidden" name="feedback_id" value="<%= reply.feedback_id %>"><input type="hidden" name="return_to" value="list"><button class="admin-action-link danger">Delete</button></form></div></article><% }); } %></div></section>
<section class="admin-panel"><header class="admin-panel-header"><div><h3>Reader Feedback</h3><p>Approved feedback Approved tab मध्ये कायम store राहतो.</p></div><div class="admin-row-actions"><% tabs.forEach(tab=>{ %><a class="admin-action-link <%= selectedStatus===tab?'active':'' %>" href="/admin/comments?status=<%= tab %>"><%= tab %> (<%= stats[tab+'_comments']||0 %>)</a><% }) %></div></header><div class="admin-feedback-list"><% if(!comments||!comments.length){ %><div class="admin-empty-inline">या status मध्ये feedback नाही.</div><% } else { comments.forEach(comment=>{ %><article class="admin-feedback-card"><header class="admin-feedback-head"><div><span class="admin-feedback-id">#<%= comment.id %></span><h3><%= comment.author_name %></h3></div><span class="admin-status admin-status-<%= comment.status %>"><%= comment.status %></span></header><dl class="admin-feedback-meta"><div><dt>Mobile</dt><dd><%= comment.author_mobile||comment.author_contact||'-' %></dd></div><div><dt>Email</dt><dd><%= comment.author_email||'-' %></dd></div><div><dt>Blog</dt><dd><%= comment.post_title||comment.post_slug %></dd></div><div><dt>Replies</dt><dd><%= comment.reply_count||0 %></dd></div></dl><div class="admin-feedback-message"><span>Feedback</span><p><%= comment.comment_text %></p></div><div class="admin-row-actions admin-feedback-actions"><a class="admin-action-link" href="/admin/comments/<%= comment.id %>">View Replies (<%= comment.reply_count||0 %>)</a><% if(comment.status!=='approved'){ %><form method="post" action="/admin/comments/<%= comment.id %>/status"><input type="hidden" name="status" value="approved"><input type="hidden" name="return_status" value="<%= selectedStatus %>"><button class="admin-action-link">Approve</button></form><% } %><% if(comment.status!=='rejected'){ %><form method="post" action="/admin/comments/<%= comment.id %>/status"><input type="hidden" name="status" value="rejected"><input type="hidden" name="return_status" value="<%= selectedStatus %>"><button class="admin-action-link danger">Reject</button></form><% } %><form method="post" action="/admin/comments/<%= comment.id %>/delete" onsubmit="return confirm('हा अभिप्राय आणि त्याचे सर्व replies delete करायचे आहेत का?');"><input type="hidden" name="return_status" value="<%= selectedStatus %>"><button class="admin-action-link danger">Delete</button></form></div></article><% }); } %></div></section></main></div>
