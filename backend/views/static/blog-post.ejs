<header>
  <div class="header-container">
    <a href="<%= siteRootHref %>/index.html" class="logo-link">
      <img src="<%= siteRootHref %>/Vakibh/vaakibh_logo.svg" alt="वाकीभ लोगो" class="logo-img">
    </a>
  </div>
</header>

<main class="post-main" style="padding-top: 80px; padding-bottom: 60px;">
  <nav class="sant-breadcrumb" aria-label="Breadcrumb">
    <a href="<%= siteRootHref %>/index.html">गृहपृष्ठ</a>
    <span class="bc-sep"> &rsaquo; </span>
    <a href="<%= blogIndexHref %>">ब्लॉग</a>
    <span class="bc-sep"> &rsaquo; </span>
    <span><%= post.title %></span>
  </nav>

  <article class="post-article" style="max-width: 960px; margin: 0 auto; background: #fff; padding: 40px; border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
    <div style="margin: -8px 0 28px; border-radius: 18px; overflow: hidden; box-shadow: 0 10px 24px rgba(0,0,0,0.08);">
      <img src="<%= post.featured_image %>" alt="<%= post.featured_image_alt || post.title %>" style="width: 100%; height: auto; display: block;">
    </div>
    <header class="post-header blog-post-heading">
      <div class="blog-post-heading-row">
        <h1 class="post-title"><%= post.title %></h1>
      <% if (post.published_label) { %>
        <time class="blog-post-date" datetime="<%= post.published_at instanceof Date ? post.published_at.toISOString() : post.published_at %>"><%= post.published_label %></time>
      <% } %>
      </div>
    </header>
    <div class="post-content">
      <%- post.content_html %>
    </div>
  </article>
</main>
