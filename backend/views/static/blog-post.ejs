<header>
  <div class="header-container">
    <a href="<%= siteRootHref %>/index.html" class="logo-link">
      <img src="<%= siteRootHref %>/Vakibh/vaakibh_logo.svg" alt="वाकीभ लोगो" class="logo-img">
    </a>
  </div>
</header>

<main class="post-main" style="padding-top: 80px; padding-bottom: 60px;">
  <nav class="sant-breadcrumb" aria-label="Breadcrumb">
    <a href="<%= siteRootHref %>/index.html">गृहपृष्ठ</a>
    <span class="bc-sep"> &rsaquo; </span>
    <a href="<%= blogIndexHref %>">ब्लॉग</a>
    <span class="bc-sep"> &rsaquo; </span>
    <span><%= post.title %></span>
  </nav>

  <article class="post-article" style="max-width: 960px; margin: 0 auto; background: #fff; padding: 40px; border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
    <div style="margin: -8px 0 28px; border-radius: 18px; overflow: hidden; box-shadow: 0 10px 24px rgba(0,0,0,0.08);">
      <img src="<%= post.featured_image %>" alt="<%= post.featured_image_alt || post.title %>" style="width: 100%; height: auto; display: block;">
    </div>
    <header class="post-header blog-post-heading">
      <div class="blog-post-heading-row">
        <h1 class="post-title"><%= post.title %></h1>
      <% if (post.published_label) { %>
        <time class="blog-post-date" datetime="<%= post.published_at instanceof Date ? post.published_at.toISOString() : post.published_at %>"><%= post.published_label %></time>
      <% } %>
      </div>
    </header>
    <div class="post-content">
      <%- post.content_html %>
    </div>

    <section class="blog-feedback-section" data-blog-feedback data-post-slug="<%= post.slug %>" style="margin-top: 34px; border-top: 1px solid #f0d5ab; padding-top: 28px;">
      <div style="background: #fffaf3; border: 1px solid #f0d5ab; border-radius: 18px; padding: 24px; box-shadow: 0 10px 24px rgba(160, 32, 32, 0.06);">
        <h2 style="margin: 0 0 8px; color: #a02020; font-size: 1.45rem;">अभिप्राय</h2>
        <p style="margin: 0 0 18px; color: #5f5147; font-weight: 600;">हा ब्लॉग वाचून तुम्हाला काय वाटले?</p>
        <form class="blog-feedback-form" data-blog-feedback-form>
          <input type="hidden" name="slug" value="<%= post.slug %>">
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px; margin-bottom: 14px;">
            <label style="display: grid; gap: 6px; color: #4b4038; font-weight: 700;">नाव<input type="text" name="name" required maxlength="120" style="width: 100%; border: 1px solid #eac894; border-radius: 12px; padding: 11px 12px; background: #fff; color: #222;"></label>
            <label style="display: grid; gap: 6px; color: #4b4038; font-weight: 700;">मोबाईल / ईमेल<input type="text" name="contact" maxlength="191" style="width: 100%; border: 1px solid #eac894; border-radius: 12px; padding: 11px 12px; background: #fff; color: #222;"></label>
          </div>
          <label style="display: grid; gap: 6px; color: #4b4038; font-weight: 700;">तुमचा अभिप्राय<textarea name="message" required rows="4" maxlength="2000" style="width: 100%; border: 1px solid #eac894; border-radius: 12px; padding: 11px 12px; resize: vertical; background: #fff; color: #222;"></textarea></label>
          <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-top: 16px;">
            <button type="submit" style="border: 0; border-radius: 999px; background: #ff8a00; color: #fff; padding: 10px 22px; font-weight: 800; cursor: pointer;">पाठवा</button>
            <span data-blog-feedback-status style="color: #5f5147; font-weight: 700;"></span>
          </div>
        </form>
        <div data-blog-feedback-list style="display: grid; gap: 12px; margin-top: 22px;"></div>
      </div>
    </section>
    <script>
    (function () {
      var section = document.currentScript.previousElementSibling;
      if (!section || !section.matches('[data-blog-feedback]')) return;
      var slug = section.getAttribute('data-post-slug') || '';
      var form = section.querySelector('[data-blog-feedback-form]');
      var status = section.querySelector('[data-blog-feedback-status]');
      var list = section.querySelector('[data-blog-feedback-list]');
      function text(value) {
        return String(value || '').replace(/[&<>"']/g, function (char) {
          return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char];
        });
      }
      function renderComments(comments) {
        if (!list || !comments || !comments.length) return;
        list.innerHTML = '<h3 style="margin:0;color:#a02020;font-size:1.1rem;">वाचकांचे अभिप्राय</h3>' + comments.map(function (comment) {
          return '<article style="background:#fff;border:1px solid #f0d5ab;border-radius:14px;padding:14px 16px;"><strong style="display:block;color:#3d332c;">' + text(comment.author_name) + '</strong><p style="margin:6px 0 0;color:#4b4038;white-space:pre-wrap;">' + text(comment.comment_text) + '</p></article>';
        }).join('');
      }
      if (slug && window.fetch) {
        fetch('/api/blog-comments/' + encodeURIComponent(slug))
          .then(function (response) { return response.ok ? response.json() : { comments: [] }; })
          .then(function (data) { renderComments(data.comments || []); })
          .catch(function () {});
      }
      if (form && window.fetch) {
        form.addEventListener('submit', function (event) {
          event.preventDefault();
          status.textContent = 'पाठवत आहे...';
          fetch('/api/blog-comments', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ slug: slug || form.slug.value, name: form.name.value, contact: form.contact.value, message: form.message.value })
          })
            .then(function (response) { return response.json().then(function (data) { return { ok: response.ok, data: data }; }); })
            .then(function (result) {
              if (!result.ok || !result.data.ok) throw new Error(result.data.message || 'अभिप्राय पाठवता आला नाही.');
              form.reset();
              status.textContent = 'धन्यवाद. तुमचा अभिप्राय approval नंतर दिसेल.';
            })
            .catch(function (error) {
              status.textContent = error.message || 'अभिप्राय पाठवता आला नाही.';
            });
        });
      }
    })();
    </script>
  </article>
</main>
