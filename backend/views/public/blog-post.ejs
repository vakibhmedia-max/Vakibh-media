<header>
  <div class="header-container">
    <a href="/index.html" class="logo-link">
      <img src="/Vakibh/vaakibh_logo.svg" alt="वाकीभ लोगो" class="logo-img">
    </a>
  </div>
</header>

<main class="post-main blog-post-main">
  <nav class="sant-breadcrumb" aria-label="Breadcrumb">
    <a href="/index.html">गृहपृष्ठ</a>
    <span class="bc-sep"> &rsaquo; </span>
    <a href="/blog/index.html">ब्लॉग</a>
    <span class="bc-sep"> &rsaquo; </span>
    <span><%= post.title %></span>
  </nav>

  <article class="post-article blog-post-card abhang-post" id="post-<%= post.id %>">
    <div class="blog-post-thumb">
      <img src="<%= post.featured_image %>" alt="<%= post.featured_image_alt || post.title %>" style="width: 100%; height: auto; object-fit: contain;">
    </div>

    <div class="blog-post-body">
      <header class="post-header">
        <div class="blog-post-kicker">
          <span class="arrival-date"><%= formatDate(post.published_at) || post.card_label || 'वाकीभ ब्लॉग' %></span>
        </div>
        <h1 class="post-title"><%= post.title %></h1>
        <p class="arrival-author"><%= post.author_name %></p>
      </header>

      <div class="post-content blog-post-content">
        <%- post.content_html %>
      </div>

      <div class="abhang-post-actions abhang-card-footer" data-share-scope="post">
        <div class="abhang-actions-left">
          <button class="abhang-btn copy-abhang-btn" aria-label="लेख कॉपी करा">
            <i class="far fa-copy"></i>
          </button>
          <div class="abhang-share-group">
                  <a class="abhang-btn whatsapp-share-btn" href="https://wa.me/919923916476" target="_blank" rel="noopener noreferrer" aria-label="व्हॉट्सअॅपवर संपर्क करा">
                    <i class="fab fa-whatsapp"></i>
                  </a>
                  <a class="abhang-btn facebook-share-btn" href="https://www.facebook.com/vaakibh" target="_blank" rel="noopener noreferrer" aria-label="फेसबुक पेजला भेट द्या">
                    <i class="fab fa-facebook-f"></i>
                  </a>
                  <a class="abhang-btn instagram-share-btn" href="https://www.instagram.com/_vaakibh?igsh=MWJyYndzc3Rzc2k3MQ%3D%3D&utm_source=qr" target="_blank" rel="noopener noreferrer" aria-label="इंस्टाग्राम प्रोफाइलला भेट द्या">
                    <i class="fab fa-instagram"></i>
                  </a>
          </div>
        </div>
      </div>

      <div class="blog-post-footer">
        <a class="blog-back-link" href="/blog/index.html">
          <i class="fas fa-arrow-left"></i>
          ब्लॉगवर परत
        </a>
      </div>
    </div>
  </article>
</main>
