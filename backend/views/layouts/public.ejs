<!DOCTYPE html>
<%
  const pageLang = typeof lang !== 'undefined' ? lang : 'mr';
  const pageTitle = typeof title !== 'undefined' ? title : 'वाकीभ';
  const pageDescription = typeof description !== 'undefined' ? description : '';
  const pageBodyClass = typeof bodyClass !== 'undefined' ? bodyClass : '';
  const layoutExtraHead = typeof extraHead !== 'undefined' ? extraHead : '';
%>
<html lang="<%= pageLang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %></title>
  <% if (pageDescription) { %>
    <meta name="description" content="<%= pageDescription %>">
  <% } %>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/Vakibh/css/style.css?v=40">
  <link rel="stylesheet" href="/Vakibh/css/sant.css?v=33">
  <link rel="stylesheet" href="/backend/blog.css?v=2">
  <% if (layoutExtraHead) { %><%- layoutExtraHead %><% } %>
</head>
<body class="<%= pageBodyClass %>">
  <%- body %>
  <script src="/Vakibh/js/main.js?v=110" defer></script>
</body>
</html>
