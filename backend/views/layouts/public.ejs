<!DOCTYPE html>
<%
  const pageLang = typeof lang !== 'undefined' ? lang : 'mr';
  const pageTitle = typeof title !== 'undefined' ? title : 'वाकीभ';
  const pageDescription = typeof description !== 'undefined' ? description : '';
  const pageBodyClass = typeof bodyClass !== 'undefined' ? bodyClass : '';
%>
<html lang="<%= pageLang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %></title>
  <% if (pageDescription) { %>
    <meta name="description" content="<%= pageDescription %>">
  <% } %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Mukta:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/Vakibh/css/style.css?v=13">
  <link rel="stylesheet" href="/Vakibh/css/sant.css?v=13">
  <link rel="stylesheet" href="/backend/blog.css?v=1">
</head>
<body class="<%= pageBodyClass %>">
  <%- body %>
  <script src="/Vakibh/js/main.js?v=22" defer></script>
</body>
</html>
